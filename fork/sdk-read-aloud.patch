diff --git a/sdk/host-elements.d.ts b/sdk/host-elements.d.ts
index 82f81e2..094274e 100644
--- a/sdk/host-elements.d.ts
+++ b/sdk/host-elements.d.ts
@@ -805,6 +805,18 @@ export interface SpHostElements {
 		'class'?: SpAttr
 		slot?: string
 	}
+	/**
+	 * 🚧 A play/stop toggle that reads `text` aloud with the viewer's own speech voices (1.5), drawn by the host (`sp-read-aloud-button`, `aria-pressed` while reading). `speaker` keys the voice — a speaker reference such as `character:3`, the same one `sp-avatar` takes — so a character keeps one voice wherever they are read; `speaker-name` is how the viewer's voice settings list them. Action lines (`*smiles*`) may be read in another voice or skipped, as the viewer chose. One element plays at a time page-wide, and a changed `text` stops it. Draws nothing when the browser has no voices or `text` is empty.
+	 * Parts: `.sp-read-aloud`, `.sp-read-aloud-button`.
+	 */
+	'sp-read-aloud': {
+		'text'?: SpAttr
+		'speaker'?: SpAttr
+		'speaker-name'?: SpAttr
+		'label'?: SpAttr
+		'class'?: SpAttr
+		slot?: string
+	}
 	/**
 	 * The app's composer text field, host-owned: the caret stays on the page. `input` / `change` carry `{ value }`; `submit` carries `{ value }` on the send key (Enter without Shift) unless `submit-on="none"`. `keys` names keys the widget handles itself (`ArrowUp ArrowDown Tab Escape Enter`; a bare `Enter` leaves Shift+Enter to the field), or a key only while a modifier is held (`Control+Enter Meta+Enter`; `Control`, `Meta`, `Shift`): each is kept from the field and raised as `key` (`{ key, shift, ctrl, meta }`). `autofocus` (core's alone) gives the field the caret, at its end, as it lands. The `aria-*` given here go on the field itself; `field-class` replaces the field's own classes (a composer skin styles the field, not its wrapper).
 	 * Parts: `.sp-composer-field`.
