From 6e89117d00605f168ba9b468bbb857db0447a124 Mon Sep 17 00:00:00 2001
From: GreenJimmy <j.thompson@mac.com>
Date: Tue, 17 Nov 2026 11:19:02 -0700
Subject: [PATCH] Add a "Back to the start of this message" link to the message
 card

A long reply leaves the reader at its end. The card now ends with a faint
arrow (`messages.message-jump`) linking to `#message-{id}`; the host moves
an in-box fragment link within the box, so it scrolls the log to the
message's top without touching the page's URL.

Needs the host's in-box fragment-link handling (serene-pub, same name).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BkrH6FneTWmpwJxZyXweNU
---
 .../shared/messages/SessionMessage.svelte           | 13 +++++++++++++
 guides/widgets.md                                   |  2 +-
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/core-catalog/components/shared/messages/SessionMessage.svelte b/core-catalog/components/shared/messages/SessionMessage.svelte
index dd18ee2..87d6c9f 100644
--- a/core-catalog/components/shared/messages/SessionMessage.svelte
+++ b/core-catalog/components/shared/messages/SessionMessage.svelte
@@ -1234,6 +1234,19 @@
 		     the height-animated wrapper above, because a decision landing here
 		     must not look like the body re-rendering. -->
 		<MessageStateLedger messageId={msg.id} />
+
+		<!-- Back to where a long line began. The page moves a box's in-box
+		     fragment link within the box, without touching its URL. -->
+		{#if !contentOnly && !isEditing && msg.content?.trim()}
+			<a
+				href="#message-{msg.id}"
+				data-widget-part="messages.message-jump messages.message-icon-button"
+				aria-label="Back to the start of this message"
+				title="Back to the start of this message"
+			>
+				<sp-icon name="arrow-up-to-line" size="14"></sp-icon>
+			</a>
+		{/if}
 	</div>
 
